# Copiez ce fichier en .env et renseignez vos valeurs :  cp .env.example .env

# --- Ports exposés sur la machine hôte ---
BACKEND_PORT=8000
MONGO_PORT=27017
MILVUS_PORT=19530

# --- Application ---
ENVIRONMENT=development

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=ffe_chess

# --- Milvus (noms de service internes au réseau Docker) ---
MILVUS_HOST=milvus
MILVUS_PORT=19530

# --- APIs externes ---
LICHESS_API_BASE=https://explorer.lichess.ovh
STOCKFISH_PATH=/usr/games/stockfish
YOUTUBE_API_KEY=votre_cle_api_youtube_ici
